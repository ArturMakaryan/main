(function () {
  var telegramUrl = "https://t.me/YOUR_KONTRBET_USERNAME";

  function addTelegramButton() {
    if (document.querySelector('[data-mj="kontrbet-telegram-button"]')) return;

    var headerRight = document.querySelector('[data-mj="header-right"]');
    if (!headerRight) return;

    var button = document.createElement("a");
    button.setAttribute("data-mj", "kontrbet-telegram-button");
    button.href = telegramUrl;
    button.target = "_blank";
    button.rel = "noopener noreferrer";
    button.setAttribute("aria-label", "Telegram");

    headerRight.prepend(button);
  }

  function addTelegramButtonStyles() {
    if (document.querySelector('[data-mj="kontrbet-telegram-button-styles"]')) return;

    var style = document.createElement("style");
    style.setAttribute("data-mj", "kontrbet-telegram-button-styles");
    style.textContent = [
      '[data-mj="kontrbet-telegram-button"] {',
      '  display: inline-flex !important;',
      '  align-items: center !important;',
      '  justify-content: center !important;',
      '  width: 40px !important;',
      '  min-width: 40px !important;',
      '  height: 40px !important;',
      '  min-height: 40px !important;',
      '  padding: 0 !important;',
      '  border: 0 !important;',
      '  background-color: red !important;',
      '  background-image: url("https://cdn.jsdelivr.net/gh/ArturMakaryan/main@87d023f/assets/telegram.svg") !important;',
      '  background-position: center !important;',
      '  background-repeat: no-repeat !important;',
      '  background-size: 24px 24px !important;',
      '  box-shadow: none !important;',
      '  font-size: 0 !important;',
      '}',
      '[style*="#b3b3b3"] {',
      '  border-color: #1c1c26 !important;',
      '}',
    ].join("\n");

    document.head.appendChild(style);
  }

  addTelegramButtonStyles();
  addTelegramButton();

  new MutationObserver(addTelegramButton).observe(document.body, {
    childList: true,
    subtree: true,
  });
})();
